rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && (request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '').lower() in [
          'abhishekredddy500@gmail.com', 'vishnudeviprasadshetty@gmail.com', 'supritachat.25@gmail.com'
        ]));
    }
    // Product photography is public. Customer details must never be stored here.
    match /products/{product}/{image} {
      allow read: if true;
      allow create, update: if admin() && request.resource.size < 6 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    // Private customer references. No public token URLs are generated by the app.
    match /references/{uid}/{requestId}/{productId}/{image} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 6 * 1024 * 1024 && request.resource.contentType == 'image/jpeg' &&
        image.matches('^[a-zA-Z0-9_-]+[.]jpg$');
      allow delete: if request.auth != null && (request.auth.uid == uid || admin());
    }
    match /{path=**} { allow read, write: if false; }
  }
}
